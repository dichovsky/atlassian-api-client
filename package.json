{
  "name": "atlassian-api-client",
  "version": "5.0.0",
  "description": "Typed Node.js/TypeScript clients and CLI for Confluence Cloud v2, Jira Cloud Platform v3, Jira Software/Agile, and DevOps APIs",
  "keywords": [
    "atlassian",
    "confluence",
    "jira",
    "api",
    "client",
    "sdk",
    "cli",
    "typescript",
    "rest",
    "claude-code",
    "agent",
    "skill"
  ],
  "homepage": "https://github.com/dichovsky/atlassian-api-client#readme",
  "bugs": {
    "url": "https://github.com/dichovsky/atlassian-api-client/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dichovsky/atlassian-api-client.git"
  },
  "funding": {
    "type": "buymeacoffee",
    "url": "https://buymeacoffee.com/dichovsky"
  },
  "license": "MIT",
  "author": "Igor Magdich <magdich.igor@gmail.com>",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "atlas": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "skill",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md",
    "docs/ARCHITECTURE.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "changelog": "conventional-changelog -p conventionalcommits",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; for (const path of ['dist', 'coverage']) rmSync(path, { recursive: true, force: true })\"",
    "codemap": "node scripts/generate-codemap.js",
    "codemap:check": "node scripts/generate-codemap.js --check",
    "filemode:check": "node scripts/check-file-modes.js",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives .",
    "lint:fix": "npm run lint -- --fix",
    "prepublishOnly": "npm run validate",
    "release:check": "node scripts/validate-release-tag.js",
    "api-coverage": "python3 scripts/api-gap-analysis.py",
    "test": "npm run test:unit && npm run test:api-gap",
    "test:api-gap": "vitest run --config vitest.api-gap.config.ts",
    "test:coverage": "vitest run --coverage",
    "spec-drift": "node scripts/regenerate-types.ts",
    "test:exports": "node scripts/validate-exports.js",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "validate": "npm run clean && npm run validate:quality && npm run test:coverage && npm run test:api-gap && npm run validate:package",
    "validate:package": "npm run build && npm run test:exports",
    "validate:quality": "npm run filemode:check && npm run typecheck && npm run codemap:check && npm run lint && npm run format:check"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "conventional-changelog": "^8.1.3",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "fast-check": "^4.11.0",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "typescript": "7.0.2",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
