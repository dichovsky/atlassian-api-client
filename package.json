{
  "name": "atlassian-api-client",
  "version": "4.0.0",
  "description": "Typed Node.js/TypeScript clients and CLI for Confluence Cloud v2, Jira Cloud Platform v3, Jira Software/Agile, and DevOps APIs",
  "keywords": [
    "atlassian",
    "confluence",
    "jira",
    "api",
    "client",
    "sdk",
    "cli",
    "typescript",
    "rest",
    "claude-code",
    "agent",
    "skill"
  ],
  "homepage": "https://github.com/dichovsky/atlassian-api-client#readme",
  "bugs": {
    "url": "https://github.com/dichovsky/atlassian-api-client/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dichovsky/atlassian-api-client.git"
  },
  "funding": {
    "type": "buymeacoffee",
    "url": "https://buymeacoffee.com/dichovsky"
  },
  "license": "MIT",
  "author": "Igor Magdich <magdich.igor@gmail.com>",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "atlas": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "skill",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md",
    "docs/ARCHITECTURE.md"
  ],
  "scripts": {
    "build": "npm run tsc:7 -- -p tsconfig.build.json",
    "changelog": "conventional-changelog -p conventionalcommits -i CHANGELOG.md -s",
    "clean": "rimraf dist coverage",
    "codemap": "node scripts/generate-codemap.js",
    "codemap:check": "node scripts/generate-codemap.js --check",
    "filemode:check": "node scripts/check-file-modes.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepublishOnly": "npm run validate",
    "release:check": "node scripts/validate-release-tag.js",
    "api-coverage": "python3 scripts/api-gap-analysis.py",
    "test": "npm run test:unit && npm run test:api-gap",
    "test:api-gap": "vitest run --config vitest.api-gap.config.ts",
    "test:coverage": "vitest run --coverage",
    "spec-drift": "node --experimental-strip-types scripts/regenerate-types.ts",
    "test:exports": "node scripts/validate-exports.js",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "toolchain:check": "node scripts/check-typescript-toolchain.js",
    "tsc:6": "node node_modules/typescript/bin/tsc6",
    "tsc:7": "node node_modules/@typescript/native/bin/tsc",
    "typecheck": "npm run tsc:7 -- --noEmit",
    "typecheck:ts6": "npm run tsc:6 -- --noEmit --stableTypeOrdering",
    "validate": "npm run clean && npm run validate:quality && npm run test:coverage && npm run test:api-gap && npm run validate:package",
    "validate:package": "npm run build && npm run test:exports",
    "validate:quality": "npm run filemode:check && npm run toolchain:check && npm run typecheck:ts6 && npm run typecheck && npm run codemap:check && npm run lint && npm run format:check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "@types/node": "^26.3.0",
    "@vitest/coverage-v8": "^4.1.9",
    "conventional-changelog-cli": "^5.0.0",
    "eslint": "^10.9.1",
    "fast-check": "^4.8.0",
    "globals": "^17.7.0",
    "prettier": "^3.9.4",
    "rimraf": "^6.1.3",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
